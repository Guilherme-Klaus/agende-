datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id              String          @id @default(uuid())
  name            String
  slug            String?         @unique
  category        String?
  whatsapp        String?
  address         String?
  closingHour     String?
  themeColor      String          @default("emerald")
  logoUrl         String?
  pixKey          String?         
  
  // --- NOVOS CAMPOS ADICIONADOS ---
  minNoticeHours  Int             @default(2)     // Antecedência mínima em horas
  requireDeposit  Boolean         @default(false) // Se exige sinal ou não
  depositPercent  Int             @default(50)    // Porcentagem do sinal (ex: 50%)

  users           User[]
  services        Service[]
  products        Product[]       
  professionals   Professional[]
  customers       Customer[]
  appointments    Appointment[]
  businessHours   BusinessHour[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
}

model Service {
  id           String        @id @default(uuid())
  name         String
  duration     Int
  price        Float
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  price       Float
  stock       Int      @default(0)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}

model Professional {
  id           String             @id @default(uuid())
  name         String
  nickname     String?
  avatarUrl    String?
  email        String?            @unique
  password     String?
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
  hours        ProfessionalHour[]
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  phone        String
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id             String        @id @default(uuid())
  date           DateTime
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id])
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id])
  createdAt      DateTime      @default(now())
}

model BusinessHour {
  id         String   @id @default(uuid())
  dayOfWeek  Int      
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00")
  closeTime  String   @default("19:00")
  lunchStart String   @default("12:00")
  lunchEnd   String   @default("13:00")
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model ProfessionalHour {
  id             String       @id @default(uuid())
  dayOfWeek      Int
  isOpen         Boolean      @default(true)
  openTime       String       @default("09:00")
  closeTime      String       @default("19:00")
  lunchStart     String       @default("12:00")
  lunchEnd       String       @default("13:00")
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
}