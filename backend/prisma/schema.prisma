datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  category      String?
  whatsapp      String?
  address       String?
  closingHour   String?
  users         User[]
  services      Service[]
  professionals Professional[]
  customers     Customer[]
  appointments  Appointment[]
  businessHours BusinessHour[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Service {
  id           String        @id @default(uuid())
  name         String
  duration     Int           @default(30)
  price        Float         @default(0.0)
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Professional {
  id                String             @id @default(uuid())
  name              String
  nickname          String?
  avatarUrl         String?
  email             String?            @unique
  password          String?
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  professionalHours ProfessionalHour[]
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  phone        String
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  id             String        @id @default(uuid())
  date           DateTime
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
}

model BusinessHour {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00")
  closeTime  String   @default("19:00")
  lunchStart String?  @default("12:00")
  lunchEnd   String?  @default("13:00")
}

model ProfessionalHour {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Int          
  isOpen         Boolean      @default(true)
  openTime       String       @default("09:00")
  closeTime      String       @default("19:00")
  lunchStart     String?      @default("12:00")
  lunchEnd       String?      @default("13:00")
}