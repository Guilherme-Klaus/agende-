datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id          String    @id @default(uuid())
  name        String
  slug        String?   @unique
  category    String?
  whatsapp    String?
  address     String?
  closingHour String?
  themeColor  String    @default("emerald")
  logoUrl     String?
  pixKey      String?
  isActive    Boolean   @default(false)
  dueDate     DateTime?

  minNoticeHours  Int     @default(2)
  requireDeposit  Boolean @default(false)
  depositPercent  Int     @default(50)
  portfolioPhotos String? // Novo: Armazena as fotos do portfólio (separadas por vírgula ou JSON)

  users         User[]
  services      Service[]
  products      Product[]
  professionals Professional[]
  customers     Customer[]
  appointments  Appointment[]
  businessHours BusinessHour[]
  expenses      Expense[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Service {
  id           String        @id @default(uuid())
  name         String
  duration     Int
  price        Float
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Product {
  id       String @id @default(uuid())
  name     String
  price    Float
  stock    Int    @default(0)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Professional {
  id           String             @id @default(uuid())
  name         String
  nickname     String?
  avatarUrl    String?
  email        String?            @unique
  password     String?
  commission   Float              @default(50.0) // Novo: Porcentagem de comissão do profissional (ex: 50%)
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  hours        ProfessionalHour[]
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  phone        String
  birthDate    String?
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  id             String        @id @default(uuid())
  date           DateTime
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  review         Review?
  createdAt      DateTime      @default(now())
}

model Review {
  id            String      @id @default(uuid())
  rating        Int
  comment       String?
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  date        DateTime @default(now())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model BusinessHour {
  id         String  @id @default(uuid())
  dayOfWeek  Int
  isOpen     Boolean @default(true)
  openTime   String  @default("09:00")
  closeTime  String  @default("19:00")
  lunchStart String  @default("12:00")
  lunchEnd   String  @default("13:00")
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ProfessionalHour {
  id             String       @id @default(uuid())
  dayOfWeek      Int
  isOpen         Boolean      @default(true)
  openTime       String       @default("09:00")
  closeTime      String       @default("19:00")
  lunchStart     String       @default("12:00")
  lunchEnd       String       @default("13:00")
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}
